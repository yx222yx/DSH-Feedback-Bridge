{
  "name": "dsh-feedback-bridge",
  "version": "0.1.0",
  "description": "DSH Feedback Bridge\uff08DSH \u793e\u533a\u53cd\u9988\u6865\uff09\u2014 a DeepSeek Harness plugin that helps users prepare privacy-aware community feedback.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.2.0"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:pack": "npm pack --dry-run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
